# Personal overrides for make generate-env (copy to user.env).
#
# Option A — auto-load (no sourcing needed):
#   cp user.env.example user.env
#   make generate-env
#
# Option B — source into your shell first:
#   cp user.env.example user.env
#   source user.env          # auto-export wrapper below makes this work
#   make generate-env
#
# You can also use: source scripts/source-user-env.sh
#
# Shell exports always win over values in user.env.

# Auto-export assignments when this file is sourced directly.
[[ "${BASH_SOURCE[0]}" != "${0}" ]] && set -a

# Cluster Configuration
CLUSTER_NAME=my-cluster
BASE_DOMAIN=example.com

# Network / DPU (required)
DPU_HOST_CIDR=10.0.110.0/24
API_VIP=10.1.150.100
INGRESS_VIP=10.1.150.101
BFB_URL=https://content.mellanox.com/BlueField/...

# Optional overrides (uncomment as needed)
# OPENSHIFT_VERSION=4.22.7-multi
# SKIP_BRIDGE_CONFIG=true
# NODES_MTU=9000

[[ "${BASH_SOURCE[0]}" != "${0}" ]] && set +a
